{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DeepStream: attach container",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/workspace/src"
        }
      ],
      "justMyCode": true,
      "preLaunchTask": "debug: container"
    }
  ]
}

