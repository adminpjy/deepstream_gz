# Copy to .env before the first run. Values below are development placeholders,
# not production credentials.
COMPOSE_PROJECT_NAME=deepstream-ai
APP_IMAGE=deepstream-ai-platform:dev
APP_DOCKERFILE=docker/Dockerfile
DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:9.0-triton-multiarch
CUDA_IMAGE=nvidia/cuda:13.0.2-base-ubuntu24.04
UBUNTU_MIRROR=https://archive.ubuntu.com/ubuntu
NVIDIA_CUDA_MIRROR=https://developer.download.nvidia.com
PIP_INDEX_URL=https://pypi.org/simple
PGVECTOR_IMAGE=pgvector/pgvector:pg16

POSTGRES_DB=deepstream
POSTGRES_USER=deepstream
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_DSN=postgresql://deepstream:change-this-local-password@postgres:5432/deepstream

# Leave SERVICE_GPU_IDS empty to auto-discover all physical GPUs visible in the
# container. To pin a subset use e.g. SERVICE_GPU_IDS=0,1,3.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
SERVICE_GPU_IDS=
SERVICE_SESSIONS_PER_GPU=16
CUDA_CACHE_DISABLE=0
GST_DEBUG=2
APP_LOG_LEVEL=INFO
APP_HEALTH_FILE=/tmp/deepstream-ai.ready
APP_RESTART_POLICY=no
SERVICE_PORT=8080
SERVICE_IDLE_TIMEOUT_SEC=10
SERVICE_MAX_UPLOAD_MB=2048
SERVICE_MAX_TASKS=2
SERVICE_PREVIEW_FPS=5
SERVICE_PREVIEW_WIDTH=960

# Production recognition output and the isolated result-push adapter. Leave the
# URL empty while using local JSONL/test-Web results. Formal-system integration
# changes only the publisher adapter/config, not recognition processors.
PRODUCTION_OUTPUT_ROOT=/workspace/output/production
RESULT_PUBLISH_URL=
RESULT_PUBLISH_TOKEN=
RESULT_PUBLISH_TIMEOUT_SEC=3
RESULT_PUBLISH_MAX_ATTEMPTS=3
RESULT_PUBLISH_QUEUE_SIZE=1024

# Image export/deployment helpers.
DEPLOY_COMPOSE_FILE=docker-compose.yml
