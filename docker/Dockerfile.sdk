# syntax=docker/dockerfile:1.7
# Direct SDK-package build path for networks where the much larger NGC runtime
# image is impractical to pull. BuildKit verifies the official NVIDIA package
# before exposing it to the install layer; the package is not retained in the
# final image. The original NGC-based Dockerfile remains the portable default.
ARG CUDA_IMAGE=nvidia/cuda:13.0.2-base-ubuntu24.04

FROM ${CUDA_IMAGE} AS runtime-base

ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_META_VERSION=13.1.1-1
ARG TENSORRT_VERSION=10.14.1.48-1+cuda13.0
ARG CUDNN_VERSION=9.17.1.4-1
ARG UBUNTU_MIRROR=https://archive.ubuntu.com/ubuntu
ARG NVIDIA_CUDA_MIRROR=https://developer.download.nvidia.com
ARG DEEPSTREAM_DEB_SHA256=dcd792bd5018f1fba408693b94d4fdbe9c1012f1fa0cee07cb1df29d187f44fb
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/src \
    CUDA_HOME=/usr/local/cuda-13.1 \
    CUDA_ROOT=/usr/local/cuda-13.1 \
    PATH=/usr/local/cuda-13.1/bin:/opt/nvidia/deepstream/deepstream/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib:/usr/local/cuda-13.1/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    DS_CONFIG=/workspace/configs/config.yaml

# NVIDIA publishes several incompatible TensorRT/cuDNN generations in the
# same CUDA apt repository. Pin every transitive package family, otherwise apt
# can mix 10.14 headers with 10.16/11.x libraries or cuDNN 9.17 with 9.25.
RUN printf '%s\n' \
        'Package: libnvinfer* libnvonnxparsers* python3-libnvinfer* tensorrt*' \
        "Pin: version ${TENSORRT_VERSION}" \
        'Pin-Priority: 1001' \
        '' \
        'Package: libcudnn*' \
        "Pin: version ${CUDNN_VERSION}" \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/deepstream-sdk-versions

RUN --mount=type=bind,source=docker/cache,target=/deepstream-cache,readonly \
    test "$(dpkg --print-architecture)" = amd64 \
    && sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        /etc/apt/sources.list.d/ubuntu.sources \
    && sed -i \
        "s|https://developer.download.nvidia.com|${NVIDIA_CUDA_MIRROR}|g" \
        /etc/apt/sources.list.d/*.list \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 install -y --no-install-recommends \
        ca-certificates \
    && cp /deepstream-cache/deepstream-9.0_9.0.0-1_amd64.deb /tmp/deepstream.deb \
    && test -s /tmp/deepstream.deb \
    && printf '%s  %s\n' "${DEEPSTREAM_DEB_SHA256}" /tmp/deepstream.deb \
       | sha256sum --check --strict - \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 install -y --no-install-recommends \
        "cuda-libraries-13-1=${CUDA_META_VERSION}" \
        cuda-cudart-dev-13-1 \
        libnpp-dev-13-1 \
        "libnvinfer10=${TENSORRT_VERSION}" \
        "libnvinfer-dev=${TENSORRT_VERSION}" \
        "libnvinfer-headers-dev=${TENSORRT_VERSION}" \
        "libnvonnxparsers10=${TENSORRT_VERSION}" \
        "libnvonnxparsers-dev=${TENSORRT_VERSION}" \
        "libnvinfer-plugin10=${TENSORRT_VERSION}" \
        "libnvinfer-plugin-dev=${TENSORRT_VERSION}" \
        "libnvinfer-headers-plugin-dev=${TENSORRT_VERSION}" \
        "libnvinfer-bin=${TENSORRT_VERSION}" \
        "libnvinfer-lean10=${TENSORRT_VERSION}" \
        "libnvinfer-vc-plugin10=${TENSORRT_VERSION}" \
        "libnvinfer-dispatch10=${TENSORRT_VERSION}" \
        "libcudnn9-cuda-13=${CUDNN_VERSION}" \
        gir1.2-gst-plugins-base-1.0 \
        gstreamer1.0-libav \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-tools \
        libgstrtspserver-1.0-0 \
        libjansson4 \
        libjsoncpp-dev \
        libpq-dev \
        libssl-dev \
        postgresql-client \
        procps \
        python3 \
        python3-dev \
        python3-gi \
        python3-gst-1.0 \
        python3-pip \
        tini \
        /tmp/deepstream.deb \
    && test "$(dpkg-query -W -f='${Version}' deepstream-9.0)" = 9.0.0-1 \
    && test "$(dpkg-query -W -f='${Version}' libnvinfer10)" = "${TENSORRT_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' libcudnn9-cuda-13)" = "${CUDNN_VERSION}" \
    && ln -sfn /usr/local/cuda-13.1 /usr/local/cuda \
    && ldconfig \
    && rm -f /tmp/deepstream.deb \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS bindings-builder

ARG CUDA_META_VERSION=13.1.1-1
ARG PYDS_SOURCE_REF=8ad0349ed7a496fae35ebb21c350641727070b89
ARG PYCUDA_VERSION=2025.1.2

RUN apt-get update && apt-get install -y --no-install-recommends \
        "cuda-compiler-13-1=${CUDA_META_VERSION}" \
        cuda-driver-dev-13-1 \
        cuda-profiler-api-13-1 \
        libcurand-dev-13-1 \
        autoconf \
        automake \
        build-essential \
        cmake \
        g++ \
        git \
        libcairo2-dev \
        libglib2.0-dev \
        libgirepository-2.0-dev \
        libgstreamer1.0-dev \
        libtool \
        m4 \
        meson \
        ninja-build \
        python-gi-dev \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global \
        url.https://github.com/GStreamer/gstreamer.git.insteadOf \
        https://gitlab.freedesktop.org/gstreamer/gstreamer.git \
    && for attempt in 1 2 3; do \
        rm -rf /tmp/deepstream_python_apps; \
        if mkdir -p /tmp/deepstream_python_apps \
            && cd /tmp/deepstream_python_apps \
            && git init \
            && git remote add origin \
                https://github.com/NVIDIA-AI-IOT/deepstream_python_apps.git \
            && git fetch --depth 1 origin "${PYDS_SOURCE_REF}" \
            && git checkout --detach FETCH_HEAD \
            && git submodule update --init --depth 1 --filter=blob:none \
                bindings/3rdparty/git-partial-submodule \
            && python3 bindings/3rdparty/git-partial-submodule/git-partial-submodule.py clone \
                bindings/3rdparty/pybind11 bindings/3rdparty/gstreamer; then \
            exit 0; \
        fi; \
        echo "PyDS source checkout attempt ${attempt} failed; retrying" >&2; \
        sleep "$((attempt * 5))"; \
    done; \
    exit 1

COPY docker/patches/pyds-tensor-meta-scaling.patch /tmp/pyds-tensor-meta-scaling.patch
RUN cd /tmp/deepstream_python_apps \
    && git apply --check /tmp/pyds-tensor-meta-scaling.patch \
    && git apply /tmp/pyds-tensor-meta-scaling.patch

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        "build>=1,<2" "numpy==1.26.0" \
    && cd /tmp/deepstream_python_apps/bindings \
    && CMAKE_ARGS="-DDS_VERSION=9.0 -DDS_PATH=/opt/nvidia/deepstream/deepstream" \
       CMAKE_BUILD_PARALLEL_LEVEL="$(nproc)" \
       python3 -m build --wheel \
    && mkdir -p /tmp/wheels \
    && cp dist/pyds-1.2.3-*.whl /tmp/wheels/ \
    && python3 -m pip wheel --no-cache-dir --no-deps --no-build-isolation \
        --wheel-dir /tmp/wheels \
        "pycuda==${PYCUDA_VERSION}"

COPY native/yolo_parser /tmp/yolo-parser
RUN make -C /tmp/yolo-parser
COPY native/scrfd_parser /tmp/scrfd-parser
RUN make -C /tmp/scrfd-parser

FROM runtime-base AS final

ARG PYDS_SOURCE_REF=8ad0349ed7a496fae35ebb21c350641727070b89
ARG PYCUDA_VERSION=2025.1.2
ARG TENSORRT_VERSION=10.14.1.48-1+cuda13.0
ARG CUDNN_VERSION=9.17.1.4-1
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

LABEL org.opencontainers.image.title="DeepStream AI Platform" \
      org.opencontainers.image.description="Configuration-driven DeepStream industrial video analytics runtime (local SDK deb)" \
      org.opencontainers.image.vendor="Local project" \
      org.opencontainers.image.deepstream.version="9.0" \
      org.opencontainers.image.cuda.version="13.1" \
      org.opencontainers.image.tensorrt.version="${TENSORRT_VERSION}" \
      org.opencontainers.image.cudnn.version="${CUDNN_VERSION}" \
      org.opencontainers.image.pyds.version="1.2.3" \
      org.opencontainers.image.pyds.revision="${PYDS_SOURCE_REF}" \
      org.opencontainers.image.pycuda.version="${PYCUDA_VERSION}"

COPY --from=bindings-builder /tmp/wheels /tmp/wheels
COPY --from=bindings-builder /tmp/yolo-parser/libnvdsinfer_custom_yolo_dynamic.so \
    /opt/nvidia/deepstream/deepstream/lib/libnvdsinfer_custom_yolo_dynamic.so
COPY --from=bindings-builder /tmp/scrfd-parser/libnvdsinfer_custom_scrfd.so \
    /opt/nvidia/deepstream/deepstream/lib/libnvdsinfer_custom_scrfd.so
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        "numpy==1.26.0" \
        "debugpy>=1.8,<2" \
        /tmp/wheels/pyds-1.2.3-*.whl \
        /tmp/wheels/pycuda-*.whl \
    && rm -rf /tmp/wheels \
    && python3 -m pip check \
    && python3 -c "import importlib.metadata as m, gi, numpy; gi.require_version('Gst', '1.0'); assert numpy.__version__ == '1.26.0'; assert m.version('pyds') == '1.2.3'; assert m.version('pycuda') == '${PYCUDA_VERSION}'"

WORKDIR /workspace

COPY pyproject.toml README.md ./
COPY src ./src
RUN python3 -m pip install --no-cache-dir --break-system-packages ".[dev,onnx]" \
    && python3 -c "import numpy, onnxruntime; assert numpy.__version__ == '1.26.0'"

COPY configs ./configs
COPY database ./database
COPY scripts ./scripts
RUN chmod +x /workspace/scripts/*.sh \
    && mkdir -p /workspace/models /workspace/videos /workspace/uploads /workspace/output/snapshot

# The DeepStream multi-object tracker links against Mosquitto even when the
# application does not enable MQTT output. The SDK deb declares it too loosely
# for apt to pull the shared library into this minimal runtime image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmosquitto1 \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "deepstream_ai", "serve", "--config", "/workspace/configs/config.yaml", "--host", "0.0.0.0", "--port", "8080"]
HEALTHCHECK --interval=20s --timeout=5s --start-period=120s --retries=5 \
    CMD ["/workspace/scripts/healthcheck.sh"]
